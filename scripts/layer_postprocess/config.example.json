{
  "api": {
    "context_mode": "delta",
    "base_url": "https://api.openai.com/v1",
    "model": "YOUR_VISION_MODEL",
    "api_key_env": "OPENAI_API_KEY",
    "api_key": "",
    "timeout_seconds": 180,
    "max_retries": 3,
    "image_detail": "high",
    "max_nodes": 2000,
    "max_image_mb": 20,
    "request_options": {}
  },
  "concurrency": 1,
  "max_operations": 500,
  "rules": {
    "layer1_max_area_ratio": 0.6,
    "clipped_fragment_enabled": true,
    "clipped_min_visible_ratio": 0.1,
    "clipped_strip_max_px": 8,
    "layout_enabled": true,
    "layout_split_depth": 2,
    "layout_min_gap": 24,
    "layout_gap_ratio": 0.025,
    "layout_min_extent_ratio": 0.06,
    "parent_size_tolerance": 0.02,
    "sibling_iou": 0.9,
    "fragment_max_size": 36,
    "deep_sparse_count": 2,
    "deep_small_area_px2": 256,
    "deep_small_max_side_px": 32
  },
  "grouping": {
    "max_candidates": 64,
    "group_max_gap_px": 48,
    "depth_overflow_policy": "reject",
    "group_parent_coverage_limit": 0.85,
    "group_max_intrusion_ratio": 0.15,
    "group_action": "replace_upper",
    "replacement_min_parent_area_px2": 4096
  },
  "pixels": {
    "pixel_fallback_enabled": true,
    "pixel_concurrency": 0,
    "pixel_window_px": 24,
    "pixel_variance_threshold": 50,
    "pixel_difference_threshold": 45,
    "pixel_difference_portion": 0.9,
    "pixel_min_region_px": 64,
    "pixel_max_depth": 2
  },
  "accumulation": {
    "fold_duplicate_iou": 0.9,
    "fold_duplicate_size_ratio": 0.95,
    "fold_reference_height_width_cap": 1.5,
    "fold_min_area_ratio": 0.0001,
    "fold_min_width_ratio": 0.03,
    "fold_min_height_ratio": 0.03,
    "fold_small_max_side_ratio": 0.08,
    "fold_size_similarity_ratio": 1.25,
    "fold_frequency_threshold": 20,
    "fold_frequency_step": 20,
    "fold_frequency_max_penalty": 4,
    "fold_dense_count": 16,
    "fold_overlap_coverage": 0.8,
    "fold_overlap_fraction": 0.2,
    "fold_sparse_upper_count": 2,
    "fold_sparse_min_children": 4,
    "fold_existing_coverage": 0.95
  }
}
